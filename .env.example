# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Everything has a working default that needs no cloud project, so the loop and
# the whole test suite run with this file absent.

# --- project -----------------------------------------------------------------

CINEMA_GCP_PROJECT=your-project-id

# Point the client at the emulator instead of the real database. Unset this to
# talk to Firestore for real — and be sure you meant to.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- mail --------------------------------------------------------------------

# memory | gmail
#
# Defaults to memory on purpose. Sending real email to a real seller is an
# explicit choice, not something to fall into because a token is on disk.
# Check which one is live with: curl -s localhost:8000/healthz
CINEMA_MAIL_BACKEND=memory

CINEMA_AGENT_EMAIL=producer-agent@example.com
CINEMA_AGENT_DISPLAY_NAME=Agentic Cinema

# From the OAuth client you downloaded. Only the bootstrap script reads the
# secrets file; the service uses the id and secret below plus a refresh token.
CINEMA_OAUTH_CLIENT_ID=
CINEMA_OAUTH_CLIENT_SECRET=
CINEMA_OAUTH_CLIENT_SECRETS=.secrets/client_secret.json

# --- where the refresh token lives -------------------------------------------

# file | secret-manager
#
# The whole local-to-cloud switch. `file` writes to .secrets/ (gitignored,
# mode 0600); `secret-manager` needs the project above and the secret created
# by scripts/gcp_setup.sh. Same bootstrap script either way.
CINEMA_TOKEN_BACKEND=file
CINEMA_TOKEN_DIR=.secrets
CINEMA_REFRESH_TOKEN_SECRET=gmail-agent-refresh-token

# --- loop --------------------------------------------------------------------

# How many due negotiations one tick may take. Bounded so a tick that gets
# killed has done a predictable amount of work.
CINEMA_TICK_LIMIT=50
