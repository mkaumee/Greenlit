rules_version = '2';

// Security rules are part of the product, not deployment configuration.
//
// The claim this system makes is that the agent cannot spend money. That claim
// is worth nothing if it rests on prompt design, because a prompt is a request
// and a rule is a refusal. Everything below exists so that "the agent cannot
// create a purchase order" is a fact about IAM rather than a hope about an LLM.
//
// The agent runs as a service account with no `producer` claim. A human signs
// in through Firebase Auth and gets one. Read the rules with that in mind: the
// agent is simply a caller that fails the `isProducer()` check.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Producers are humans. The agent's service account never carries this
    // claim, and nothing in the codebase can mint one for itself — custom
    // claims are set server-side by an admin, outside anything the agent runs.
    function isProducer() {
      return isSignedIn() && request.auth.token.role == 'producer';
    }

    // Whose production this is.
    //
    // Found by signing in with a second Google account and being shown
    // somebody else's props, suppliers, quotes and negotiation transcripts.
    // Every rule below said `isSignedIn()`, which was true of every Google
    // account on earth — so the panel was not showing hard-coded demo data, it
    // was showing a real production to a stranger.
    //
    // A subcollection cannot see its parent's fields, so ownership costs a
    // document read per evaluation. That is the price of the boundary being
    // real rather than being a filter in a query somebody can edit.
    function ownsProject(projectId) {
      return isSignedIn()
             && get(/databases/$(database)/documents/projects/$(projectId))
                  .data.owner_uid == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Purchase orders are NOT here
    // ---------------------------------------------------------------------
    //
    // They live in the `orders` database, under firestore.orders.rules.
    //
    // Not tidiness — necessity. Security rules do not apply to server SDKs, and
    // Firestore IAM cannot grant access to one collection and withhold another.
    // The smallest thing IAM can name is a database, so making "the agent
    // cannot write purchase orders" true had to mean a second database the
    // agent has no binding on. See scripts/gcp_setup.sh.

    // ---------------------------------------------------------------------
    // Mailboxes
    // ---------------------------------------------------------------------
    //
    // A producer connects their own Gmail and the agent negotiates as them.
    // The refresh token is NOT here — it is in Secret Manager, for the same
    // reason purchase orders are in their own database: rules do not apply to
    // server SDKs, so a rule in front of a credential is not a boundary.
    //
    // What is here is metadata: which address is connected, and whether it
    // still works. Yours and nobody else's — knowing which mailbox another
    // producer negotiates from is not a browser's business.
    //
    // Writes are server-only, always. The document is the record of a consent
    // that happened between a person and Google; a browser that could edit it
    // could mark a dead mailbox healthy and strand every negotiation on the
    // project behind it, silently.
    match /mailboxes/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // The one-time `state` binding an OAuth callback to the producer who
    // started it. Never readable from a browser: reading one is enough to
    // complete somebody else's consent and attach their mailbox to your
    // account.
    match /oauth_states/{state} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Everything else
    // ---------------------------------------------------------------------
    //
    // The agent owns the negotiation record. It may read and write projects,
    // items, suppliers, negotiations and messages freely — that is its job, and
    // none of it moves money.
    match /projects/{projectId} {
      // Owner only, on the document itself. A list query is allowed when it
      // filters on owner_uid, which is what useProjects() does — a query that
      // asked for every project is refused outright rather than silently
      // returning a subset.
      allow read: if isSignedIn() && resource.data.owner_uid == request.auth.uid;
      allow write: if isSignedIn();

      match /items/{itemId} {
        allow read: if ownsProject(projectId);
        allow write: if isSignedIn();
      }

      match /suppliers/{supplierId} {
        allow read: if ownsProject(projectId);
        allow write: if isSignedIn();
      }

      match /negotiations/{negotiationId} {
        allow read: if ownsProject(projectId);

        // The agent may drive a negotiation anywhere except into ORDERED.
        // ORDERED means a purchase order exists, and only a producer can have
        // created one. Without this, the UI could show an ordered negotiation
        // with no order behind it.
        allow create: if isSignedIn()
                      && request.resource.data.state != 'ORDERED';
        allow update: if isSignedIn()
                      && (request.resource.data.state != 'ORDERED' || isProducer());
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if ownsProject(projectId);
          // Correspondence is append-only. An agent that could rewrite what a
          // supplier said would make the timeline worthless as evidence.
          allow create: if isSignedIn();
          allow update, delete: if false;
        }
      }
    }

    // Anything not named above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
