rules_version = '2';

// Security rules are part of the product, not deployment configuration.
//
// The claim this system makes is that the agent cannot spend money. That claim
// is worth nothing if it rests on prompt design, because a prompt is a request
// and a rule is a refusal. Everything below exists so that "the agent cannot
// create a purchase order" is a fact about IAM rather than a hope about an LLM.
//
// The agent runs as a service account with no `producer` claim. A human signs
// in through Firebase Auth and gets one. Read the rules with that in mind: the
// agent is simply a caller that fails the `isProducer()` check.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Producers are humans. The agent's service account never carries this
    // claim, and nothing in the codebase can mint one for itself — custom
    // claims are set server-side by an admin, outside anything the agent runs.
    function isProducer() {
      return isSignedIn() && request.auth.token.role == 'producer';
    }

    // ---------------------------------------------------------------------
    // Purchase orders are NOT here
    // ---------------------------------------------------------------------
    //
    // They live in the `orders` database, under firestore.orders.rules.
    //
    // Not tidiness — necessity. Security rules do not apply to server SDKs, and
    // Firestore IAM cannot grant access to one collection and withhold another.
    // The smallest thing IAM can name is a database, so making "the agent
    // cannot write purchase orders" true had to mean a second database the
    // agent has no binding on. See scripts/gcp_setup.sh.

    // ---------------------------------------------------------------------
    // Everything else
    // ---------------------------------------------------------------------
    //
    // The agent owns the negotiation record. It may read and write projects,
    // items, suppliers, negotiations and messages freely — that is its job, and
    // none of it moves money.
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /items/{itemId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      match /suppliers/{supplierId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      match /negotiations/{negotiationId} {
        allow read: if isSignedIn();

        // The agent may drive a negotiation anywhere except into ORDERED.
        // ORDERED means a purchase order exists, and only a producer can have
        // created one. Without this, the UI could show an ordered negotiation
        // with no order behind it.
        allow create: if isSignedIn()
                      && request.resource.data.state != 'ORDERED';
        allow update: if isSignedIn()
                      && (request.resource.data.state != 'ORDERED' || isProducer());
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isSignedIn();
          // Correspondence is append-only. An agent that could rewrite what a
          // supplier said would make the timeline worthless as evidence.
          allow create: if isSignedIn();
          allow update, delete: if false;
        }
      }
    }

    // Anything not named above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
