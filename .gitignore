# --- agent tooling -----------------------------------------------------------
# CLAUDE.md IS committed on purpose: the hard rules are part of the deliverable.
# Local agent session state is not.
.claude/
.serena/

# --- secrets -----------------------------------------------------------------
# Nothing resembling a credential is ever committed. Refresh tokens live in
# Secret Manager; see docs/oauth-runbook.md.
.env
.env.*
!.env.example
# Both spellings. The settings default is `.secrets/` (CINEMA_TOKEN_DIR), and a
# bare `secrets/` pattern does not match a leading dot — which meant the Gmail
# refresh token was covered by nothing at all. Check with:
#   git check-ignore -v .secrets/gmail_refresh_token.json
secrets/
.secrets/
client_secret*.json
*credentials*.json
*service-account*.json
token_*.json
*.pem
*.p12

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.basedpyright/
.coverage
htmlcov/

# --- node / web --------------------------------------------------------------
node_modules/
web/dist/
web/.vite/
*.local

# --- firebase / emulator -----------------------------------------------------
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
emulator-data/

