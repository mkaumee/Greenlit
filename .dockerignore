# Keep the build context small and, more importantly, keep secrets out of it.
#
# .secrets holds Gmail refresh tokens. A copy baked into an image layer stays
# there even if a later layer deletes it, and images get pushed to a registry.

.secrets/
.env
*.env

.git/
.github/
.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Tests and their fixtures are not in the runtime image. The gate is CI's job,
# and shipping them would mean shipping pytest.
**/tests/
web/
docs/
scripts/

firestore-debug.log
*.log
Dockerfile
.dockerignore
